{
    "name": "bitbasket/mycgm-core",
    "description": "LibreLink poller, dashboard PHP API, and PWA shared by MyLibre and MyLibre-Cloud",
    "type": "library",
    "license": ["LicenseRef-SBL-1.0", "LicenseRef-OSSAL-1.0"],
    "require": {
        "php": "^8.4",
        "ext-json": "*",
        "phpexperts/rest-speaker": "^3.0",
        "phpexperts/simple-dto": "^3.9"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
